# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_CTRL_HW_CCA_VAL=20
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_)}"
CONFIG_LV_USE_SNAPSHOT=n

# ---- 离线语音识别 (esp-sr) ----
# 唤醒词: 你好小智
CONFIG_SR_WN_WN10_NIHAOXIAOZHI=y
# 命令词: MultiNet7 中文（量化版）
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
# 模型存放在 flash 的 model 分区（CONFIG_MODEL_IN_FLASH 默认生效，分区表已预留 3.9MB）
# 算力：esp-sr 推荐 240 MHz + 64 KB 数据缓存。160 MHz / 32 KB 时唤醒词和命令词同在 CPU1
# 上算不过来，任务看门狗报过 IDLE1 饿死，唤醒后的话也跟着丢
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- FATFS 中文长文件名支持 ----
# 学习清单用中文命名（如「一年级上册第三单元.txt」），家长自建时更直观。
# 默认代码页 437 不认中文，需切到 936(简体中文) 并开启长文件名 + UTF-8 API。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
